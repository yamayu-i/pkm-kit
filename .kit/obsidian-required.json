{
  "$comment": "子の .obsidian/*.json に必要なキーと値（ADR-0009）。ファイルごとではなく、ここにあるキーだけを合わせる。配列は、ここにある要素を含んでいればよい",
  "app.json": {
    "useMarkdownLinks": true,
    "newLinkFormat": "absolute",
    "alwaysUpdateLinks": true,
    "attachmentFolderPath": "asset",
    "newFileLocation": "root",
    "strictLineBreaks": true,
    "propertiesInDocument": "visible",
    "useTab": false,
    "tabSize": 2,
    "showInlineTitle": false
  },
  "appearance.json": {
    "cssTheme": "",
    "accentColor": "#6750a4",
    "translucency": false,
    "enabledCssSnippets": [
      "pkm-theme"
    ]
  },
  "community-plugins.json": [
    "pkm-git",
    "pkm-task",
    "pkm-template",
    "pkm-ribbon",
    "pkm-html",
    "pkm-diagram",
    "pkm-updates",
    "pkm-view-selector"
  ],
  "core-plugins.json": {
    "daily-notes": false,
    "properties": true,
    "canvas": false,
    "bases": false,
    "templates": false,
    "file-recovery": true
  },
  "hotkeys.json": {
    "editor:insert-link": []
  }
}
