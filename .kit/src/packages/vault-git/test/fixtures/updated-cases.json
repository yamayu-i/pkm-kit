 "shouldStamp": [
  {
   "name": "新規ファイルは付与する",
   "old": null,
   "new": "---\ntype: note\nupdated:\n---\nx\n",
   "expected": true
  },
  {
   "name": "本文が変われば付与する",
   "old": "---\ntype: note\nupdated: \"a\"\n---\nx\n",
   "new": "---\ntype: note\nupdated: \"a\"\n---\ny\n",
   "expected": true
  },
  {
   "name": "frontmatter の他の項目が変われば付与する",
   "old": "---\ntype: note\ntags: [a]\nupdated: \"a\"\n---\nx\n",
   "new": "---\ntype: note\ntags: [b]\nupdated: \"a\"\n---\nx\n",
   "expected": true
  },
  {
   "name": "updated の行だけの差は付与しない",
   "old": "---\ntype: note\nupdated: \"a\"\n---\nx\n",
   "new": "---\ntype: note\nupdated: \"b\"\n---\nx\n",
   "expected": false
  },
  {
   "name": "同じ内容は付与しない",
   "old": "---\ntype: note\nupdated: \"a\"\n---\nx\n",
   "new": "---\ntype: note\nupdated: \"a\"\n---\nx\n",
   "expected": false
  },
  {
   "name": "updated を空にしただけの差は付与しない",
   "old": "---\ntype: note\nupdated: \"a\"\n---\nx\n",
   "new": "---\ntype: note\nupdated:\n---\nx\n",
   "expected": false
  },
  {
   "name": "updated の行を足しただけの差は付与しない",
   "old": "---\ntype: note\n---\nx\n",
   "new": "---\ntype: note\nupdated: \"b\"\n---\nx\n",
   "expected": false
  }
 ],
 "mergeUpdated": [
