 "setUpdated": [
  {
   "name": "既存の updated(引用符つき)を置き換える",
   "input": "---\ntype: note\ncreated: \"2026-10-01T09:00:00+09:00\"\nupdated: \"2026-10-02T09:00:00+09:00\"\n---\n本文\n",
   "iso": "2026-11-01T13:30:00+09:00",
   "output": "---\ntype: note\ncreated: \"2026-10-01T09:00:00+09:00\"\nupdated: \"2026-11-01T13:30:00+09:00\"\n---\n本文\n"
  },
  {
   "name": "引用符なしはそのまま引用符なし",
   "input": "---\ntype: issue\ncreated: 2026-10-01T09:00:00+09:00\nupdated: 2026-10-02T09:00:00+09:00\n---\nx\n",
   "iso": "2026-11-01T13:30:00+09:00",
   "output": "---\ntype: issue\ncreated: 2026-10-01T09:00:00+09:00\nupdated: 2026-11-01T13:30:00+09:00\n---\nx\n"
  },
  {
   "name": "空の updated を埋める",
   "input": "---\ntype: note\ncreated: \"c\"\nupdated:\n---\nx\n",
   "iso": "2026-11-01T13:30:00+09:00",
   "output": "---\ntype: note\ncreated: \"c\"\nupdated: \"2026-11-01T13:30:00+09:00\"\n---\nx\n"
  },
  {
   "name": "updated がなければ created の次に足す",
   "input": "---\ntype: note\ncreated: \"c\"\ntitle: t\n---\nx\n",
   "iso": "2026-11-01T13:30:00+09:00",
   "output": "---\ntype: note\ncreated: \"c\"\nupdated: \"2026-11-01T13:30:00+09:00\"\ntitle: t\n---\nx\n"
  },
  {
   "name": "created もなければ frontmatter の末尾に足す",
   "input": "---\ntype: note\ntitle: t\n---\nx\n",
   "iso": "2026-11-01T13:30:00+09:00",
   "output": "---\ntype: note\ntitle: t\nupdated: \"2026-11-01T13:30:00+09:00\"\n---\nx\n"
  },
  {
   "name": "CRLF を保つ",
