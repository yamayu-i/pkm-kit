				"colorSpace": "srgb",
				"components": [0.1686, 0.1647, 0.1569],
				"alpha": 0.1412,
				"hex": "#2b2a28"
			},
			"$description": "カード・リスト・区切り線の枠（飾り。面の違いでも見分けられる）",
			"$extensions": {
				"com.yamayu-pkm": {
					"role": "decorative",
					"dark": {
						"colorSpace": "srgb",
						"components": [0.8157, 0.8157, 0.8157],
						"alpha": 0.1412,
						"hex": "#d0d0d0"
					},
