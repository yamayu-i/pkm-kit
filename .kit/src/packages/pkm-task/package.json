{
  "name": "pkm-task",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:vault": "node esbuild.config.mjs && node ../../../bin/lint.mjs ../../../..",
    "mcp": "node ../../../bin/mcp.mjs ../../../..",
    "preview:ui": "node preview/preview.mjs",
    "worklog:review": "node esbuild.config.mjs && node ../../../bin/worklog-review.mjs ../../../.."
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "preact": "10.29.8"
  }
}
