{
  "name": "pkm-kit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "security:scan": "node scripts/security-scan.mjs",
    "task:lint": "pnpm --filter vault-task lint:vault",
    "task:mcp": "pnpm --filter vault-task mcp",
    "task:worklog-review": "pnpm --filter vault-task worklog:review"
  }
}
